{
  "manifest_version": 3,
  "name": "XTerminator",
  "version": "0.21.0",
  "description": "Limpe posts, respostas e reposts da sua conta com prévia, filtros e intervalo configurável.",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "host_permissions": ["https://x.com/*"],
  "permissions": ["scripting", "storage"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{ "matches": ["https://x.com/*"], "js": ["filters.js", "bootstrap.js"], "run_at": "document_end" }],
  "action": { "default_popup": "popup.html", "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" } }
}
